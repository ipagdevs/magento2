							<script>
								(function () {
									var expiresAt = <?= (int) $block->getPixExpiresAtTimestamp() ?> * 1000;
									var expiredLabel = '<?= $block->escapeJs(__('QR Code expirado')) ?>';
									var container = document.getElementById('pix-expiration');
									var countdownElement = document.getElementById('pix-countdown');
									var labelElement = document.getElementById('pix-countdown-label');
									var interval;

									if (!container || !countdownElement || !labelElement) {
										return;
									}

									// Faltando menos de 5 min o aviso fica ambar; expirado, vermelho.
									var WARNING_THRESHOLD = 5 * 60;
									var states = {
										normal: {border: '#c7c7c7', background: '#fff', color: '#333'},
										warning: {border: '#f0a202', background: '#fff8e6', color: '#8a5a00'},
										expired: {border: '#d32f2f', background: '#fdecea', color: '#b71c1c'}
									};
									var currentState = null;

									function applyState(name) {
										if (currentState === name) {
											return;
										}

										currentState = name;
										container.style.borderColor = states[name].border;
										container.style.background = states[name].background;
										container.style.color = states[name].color;
									}

									function renderCountdown() {
										// renderIpagSuccessPayment() troca o #qr-info inteiro quando o pagamento confirma.
										if (!document.body.contains(container)) {
											clearInterval(interval);
											return;
										}

										var remaining = Math.floor((expiresAt - Date.now()) / 1000);

										if (remaining <= 0) {
											labelElement.style.display = 'none';
											countdownElement.textContent = expiredLabel;
											applyState('expired');
											clearInterval(interval);
											return;
										}

										var minutes = Math.floor(remaining / 60);
										var seconds = remaining % 60;
										countdownElement.textContent = (minutes < 10 ? '0' : '') + minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
										applyState(remaining <= WARNING_THRESHOLD ? 'warning' : 'normal');
									}

									interval = setInterval(renderCountdown, 1000);
									renderCountdown();
								})();
							</script>
