<?php if($block->getMethodCode() === "ipagboleto"):

$url = "";
$digitableLine = "";

if (!empty($block->getInfo('urlAuthentication'))) {
    $url = $block->getInfo('urlAuthentication');
	$digitableLine = $block->getInfo('digitableLine');
}
else {
    if (!empty($block->getInfo('links.payment'))) {
        $url = $block->getInfo('links.payment');
    }
}
?>
	<?php if (!empty($digitableLine)) : ?>
		<p style="margin-bottom: 8px;"><strong><?php echo __('Linha digitável') ?></strong></p>
		<div style="display: inline-flex; align-items: center; max-width: 100%; border: 1px solid #c7c7c7; border-radius: 10px; padding: 12px 10px 12px 18px; margin-bottom: 20px; background: #fff;">
			<code id="boleto-digitable-code" style="font-family: monospace; font-size: 1.35rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 340px; color: #333; background: transparent; -webkit-user-select: all; -moz-user-select: all; user-select: all;"><?php echo $block->escapeHtml($digitableLine); ?></code>
			<button type="button" id="button-copy-digitable-line" title="<?php echo __('Copiar linha digitável') ?>" style="background: none; border: none; cursor: pointer; display: inline-flex; align-items: center; padding: 6px 10px; margin-left: 10px; flex-shrink: 0;">
				<svg id="boleto-copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#757575" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="9" y="9" width="13" height="13" rx="2"></rect>
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
				</svg>
			</button>
		</div>
		<script>
			(function () {
				var copyButton = document.getElementById('button-copy-digitable-line');
				var codeElement = document.getElementById('boleto-digitable-code');
				var icon = document.getElementById('boleto-copy-icon');

				if (!copyButton || !codeElement || !icon) {
					return;
				}

				var originalIconHtml = icon.innerHTML;

				copyButton.addEventListener('click', function () {
					window.navigator.clipboard.writeText(codeElement.textContent).then(function () {
						icon.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';
						icon.setAttribute('stroke', '#2e7d32');
						setTimeout(function () {
							icon.innerHTML = originalIconHtml;
							icon.setAttribute('stroke', '#757575');
						}, 1200);
					});
				});
			})();
		</script>
	<?php endif; ?>
	<p>
		<a href="<?php echo $url; ?>" target="_blank" class="action primary btn-boleto boleto-ipag">
			<span><?php echo __('Imprimir Boleto') ?></span>
		</a>
	</p>
<?php endif; ?>
<?php if($block->getMethodCode() === "ipagpix") :
	$qrCode = $block->getInfo('pix.qrCode');
	$qrHelper = $block->getQrHelper($qrCode);
	$transUuid = md5($block->getInfo('id') ?: '');

	if (!empty($qrHelper)) : ?>
		<div id="qr-info" class="col-md-6">
			<div class="card card-default">
				<div class="card-body">
					<div class="text-center m-4">
						<h3>Use o QR Code do Pix para pagar</h3>
						<p>Abra o app em que vai fazer o pagamento, escaneie a imagem ou cole o código do QR Code</p>
							<img class='rounded' src='<?php echo $qrHelper?> ' style="width: 100%; max-width: 200px;" />
						<h3><?php echo $block->getGrandTotalFormatted(); ?></h3>
						<button type="button" id="button-copy" class="action primary btn-pix boleto-ipag">Copiar código do QR Code</button>
						<input type="hidden" id="brCode" value="<?php echo $qrCode; ?>">
					</div>
				</div>
			</div>
		</div>

		<script>
			var copyElement = document.getElementById("button-copy");

			copyElement.addEventListener('click', function() {
				copyText = document.getElementById("brCode");
				copyText.type = 'text';
				copyText.select();
				copyText.setSelectionRange(0, 99999);
				document.execCommand("copy");
				copyText.type = 'hidden';
			});

			copyElement.addEventListener('click', function () {
				copyElement.classList.add('copied-icon');
				copyElement.innerHTML = 'Copiado';
				setTimeout(function () {
					copyElement.classList.remove('copied-icon');
					copyElement.innerHTML = 'Copiar código do QR Code';
				}, 1000);
			});
		</script>
		<script>
			function renderIpagSuccessPayment() {
				var contentContainer = jQuery('#qr-info');

				jQuery('html,body').animate({scrollTop: contentContainer.offset().top - 150});

				contentContainer.html(`
				<div class="icon--order-success">
					<svg xmlns="http://www.w3.org/2000/svg" width="154px" height="154px">
						<g fill="none" stroke="#22AE73" stroke-width="2">
							<circle cx="77" cy="77" r="72" style="stroke-dasharray:480px, 480px; stroke-dashoffset: 960px;"></circle>
							<circle id="colored" fill="#22AE73" cx="77" cy="77" r="72"
							style="stroke-dasharray:480px, 480px; stroke-dashoffset: 960px;"></circle>
							<polyline class="st0" stroke="#fff" stroke-width="10" points="43.5,77.8 63.7,97.9 112.2,49.4 "
							style="stroke-dasharray:100px, 100px; stroke-dashoffset: 200px;" />
						</g>
					</svg>
					<h3>Pagamento confirmado!</h3>
				</div>
				`);
			}
		</script>
		<script type="module">
			import { io } from "https://cdn.socket.io/4.7.5/socket.io.esm.min.js";

			const socket = io("wss://websocket.ipag.com.br");
			const token = "<?= $transUuid ?>";

			if (token) {
				socket.on(token, function(data) {
					if (data.status == 200) {
						renderIpagSuccessPayment();
					}
				});
			}

		</script>
	<?php else : ?>
		<p>Ocorreu um erro ao gerar o QR Code, por favor entre em contato com o lojista.</p>
	<?php endif; ?>
<?php endif;

